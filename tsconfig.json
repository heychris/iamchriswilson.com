{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// and #lib is handled by the "imports" field in package.json
}
